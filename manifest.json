{
  "manifest_version": 3,
  "name": "Smartschool Combined",
  "version": "4.1.0",
  "description": "Cijfers, thema's, widgets en reveal in een paneel op de Smartschool-pagina.",
  "icons": {
    "16": "assets/icons/icon-16.png",
    "32": "assets/icons/icon-32.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  },
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://*.smartschool.be/*",
    "https://your-project-default-rtdb.europe-west1.firebasedatabase.app/*",
    "https://identitytoolkit.googleapis.com/*",
    "https://securetoken.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Smartschool Combined",
    "default_icon": {
      "16": "assets/icons/icon-16.png",
      "32": "assets/icons/icon-32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.smartschool.be/*"
      ],
      "js": [
        "preload.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://*.smartschool.be/*"
      ],
      "exclude_matches": [
        "https://*.smartschool.be/login*",
        "https://*.smartschool.be/account-verification*",
        "https://*.smartschool.be/2fa*"
      ],
      "css": [
        "themes.css"
      ],
      "js": [
        "guard.js",
        "settings.js",
        "themes.js",
        "layout.js",
        "lazy.js",
        "fifa-card.js",
        "backdrop.js",
        "cutscene.js",
        "tunnel.js",
        "cutscene-styles.js",
        "grid-percentages.js",
        "walkout.js",
        "team-nav.js",
        "settings-window.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/audio/*.mp3",
        "assets/themes/*.jpg",
        "assets/icons/logo.svg",
        "assets/islands/*.webp",
        "farm/assets/*.png",
        "farm/assets/*.svg"
      ],
      "matches": [
        "https://*.smartschool.be/*"
      ]
    }
  ]
}
